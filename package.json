{
  "name": "kiehnema",
  "version": "1.0.0",
  "description": "Kiehnema – website-to-video motion graphics for social media",
  "scripts": {
    "preview": "node render.mjs --preview",
    "music": "node music.mjs",
    "render": "node music.mjs && node render.mjs",
    "render:feed": "node music.mjs && node render.mjs --format=feed",
    "render:story": "node music.mjs && node render.mjs --format=story"
  },
  "type": "module",
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "gsap": "^3.15.0",
    "playwright": "^1.63.0"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  },
  "private": true
}
