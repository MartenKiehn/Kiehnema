# Copy to .env to override defaults (all optional)
# Require an administrator to configure AI provider after sign-in. The server installer sets this.
# Without this flag, the AWS settings below remain a fallback until AI provider is saved.
MG_PROVIDER_SETUP_REQUIRED=true
MG_BEDROCK_MODEL_ID=eu.anthropic.claude-opus-5-5
MG_AWS_REGION=eu-central-1
# Optional: use an existing named AWS profile for server/environment authentication.
# MG_AWS_PROFILE=bedrock
MG_HOST=127.0.0.1
MG_PORT=8000
MG_PUBLIC_ORIGIN=http://127.0.0.1:8000
# Direct source setup: private Linux tmpfs with swap disabled.
# The managed server installer configures /work in the container automatically.
# macOS local development only: use a mounted RAM disk; see docs/security.md.
# Ordinary disk directories are rejected.
MG_WORK_DIR=/dev/shm/kiehnema
# Optional unattended first-admin setup: username, password and recovery key together.
# TOTP is optional; administrators can require it later in Users.
# Store real values in deployment secrets. See docs/security.md for key generation.
# MG_ADMIN_USERNAME=admin
# MG_ADMIN_PASSWORD=
# MG_ADMIN_TOTP_SECRET=
# MG_ADMIN_RECOVERY_KEY=
