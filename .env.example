# Copy to .env to override defaults (all optional)
MG_BEDROCK_MODEL_ID=eu.anthropic.claude-opus-5-5
MG_AWS_REGION=eu-central-1
MG_AWS_PROFILE=bedrock
MG_HOST=127.0.0.1
MG_PORT=8000
MG_PUBLIC_ORIGIN=http://127.0.0.1:8000
# Linux: private tmpfs directory with swap disabled. macOS: a mounted RAM disk.
# See docs/security.md before running generation; ordinary disk directories are rejected.
MG_WORK_DIR=/dev/shm/kiehnema
