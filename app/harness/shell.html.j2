<!doctype html>
<html lang="{{ language }}">
<head>
  <meta charset="utf-8">
  <title>{{ title }}</title>
  <link rel="stylesheet" href="harness/harness.css">
  <link rel="stylesheet" href="theme.css">
  <link rel="stylesheet" href="composition/composition.css">
  <script type="application/json" id="mg-manifest">{{ manifest_json }}</script>
  <script type="application/json" id="mg-theme">{{ theme_json }}</script>
</head>
<body>
  <div id="stage">
{{ composition_html }}
  </div>
  <div id="mg-controls" hidden>
    <button id="mg-play" aria-label="Play preview">▶︎</button>
    <input id="mg-scrub" aria-label="Preview position" type="range" min="0" max="1" step="0.0001" value="0">
    <span id="mg-time">0.00 s</span>
    <a href="?format=feed">4:5</a> <a href="?format=story">9:16</a>
  </div>
  <script src="harness/gsap.min.js"></script>
  <script src="harness/harness.js"></script>
  <script src="composition/composition.js"></script>
</body>
</html>
